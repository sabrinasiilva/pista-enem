# Copie para api/.env (que fica fora do Git) e preencha.
# Sem a chave, o tutor funciona só com o plano B.

GEMINI_API_KEY=

# Modelo principal e reservas, em ordem, no formato modelo:nível de raciocínio
GEMINI_MODELOS=gemini-3.5-flash-lite:minimal,gemini-3.8-flash:low
IA_TEMPO_LIMITE=12
IA_TENTATIVAS_POR_MODELO=2
IA_NIVEL_DE_RACIOCINIO=low

VERSAO_PROMPT=tutor_v1

# Banco de dados. Sem isto, usa SQLite em api/pista.db (fora do Git)
# DATABASE_URL=postgresql+psycopg://usuario:senha@servidor/pista
# Em produção, o usuário dono do banco só para as migrações:
# MIGRACOES_DATABASE_URL=postgresql+psycopg://dono:senha@servidor/pista
